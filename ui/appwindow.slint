import { Button, VerticalBox, HorizontalBox, ProgressIndicator, TextEdit, CheckBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Media Transcriber";
    icon: @image-url("icon.png");
    width: 750px;
    height: 600px;
    
    in property <string> text_with_timestamps: "Awaiting transcription...";
    in property <string> text_without_timestamps: "Awaiting transcription...";
    in-out property <bool> show_timestamps: true;
    
    in property <float> progress: 0.0;
    in property <bool> is_processing: false;
    
    in property <bool> show_download_popup: false;
    in property <float> download_progress: 0.0;
    in property <bool> is_downloading: false;
    in property <string> download_error: "";
    
    callback select_file();
    callback start_transcription();
    callback copy_to_clipboard(string);
    callback save_to_file(string);
    callback start_download();

    VerticalBox {
        padding: 15px;
        spacing: 15px;
        
        Button {
            text: "Select Video File";
            clicked => { root.select_file(); }
            enabled: !root.is_processing;
        }
        
        Button {
            text: "Start Transcription";
            clicked => { root.start_transcription(); }
            enabled: !root.is_processing;
        }
        
        ProgressIndicator {
            progress: root.progress;
            indeterminate: root.is_processing && root.progress == 0.0;
        }
        
        TextEdit {
            text: root.show_timestamps ? root.text_with_timestamps : root.text_without_timestamps;
            read-only: true;
        }
        
        HorizontalBox {
            alignment: space-between;
            padding: 0px;
            
            CheckBox {
                text: "Show Timestamps";
                checked <=> root.show_timestamps;
            }
            
            HorizontalBox {
                spacing: 10px;
                padding: 0px;
                alignment: end;
                Button {
                    text: "📋 Copy to Clipboard";
                    clicked => { root.copy_to_clipboard(root.show_timestamps ? root.text_with_timestamps : root.text_without_timestamps); }
                }
                Button {
                    text: "💾 Save to File";
                    clicked => { root.save_to_file(root.show_timestamps ? root.text_with_timestamps : root.text_without_timestamps); }
                }
            }
        }
    }

    if root.show_download_popup : Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);

        Rectangle {
            width: 450px;
            height: root.download_error == "" ? 220px : 270px;
            background: #242424;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3a3a3a;
            
            VerticalBox {
                padding: 25px;
                spacing: 15px;
                alignment: space-around;
                
                Text {
                    text: "Model Download Required";
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "To transcribe media, you need to download the Whisper transcription model (approx. 465 MB). This is a one-time download.";
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                
                ProgressIndicator {
                    progress: root.download_progress;
                    indeterminate: root.is_downloading && root.download_progress == 0.0;
                }
                
                if root.download_error != "" : Text {
                    text: root.download_error;
                    color: #ff6b6b;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                
                Button {
                    text: root.is_downloading ? "Downloading..." : (root.download_error != "" ? "Retry" : "Download Now");
                    clicked => { root.start_download(); }
                    enabled: !root.is_downloading;
                }
            }
        }
    }
}
